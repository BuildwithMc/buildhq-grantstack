# GrantStack — Environment Variables
# Copy this file to .env and fill in your values

# Full path to your Google Service Account JSON key file
# Example: C:\Users\mmeri\Downloads\grantstack-key.json
GOOGLE_SERVICE_ACCOUNT_JSON=C:\path\to\your-service-account-key.json

# Your personal Google account email (the sheet is shared with you automatically)
GOOGLE_ACCOUNT_EMAIL=you@gmail.com

# Anthropic API key (for AI grant search) — get it at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
